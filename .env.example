# Скопируйте в .env и заполните. .env в git не попадает.

# Токен от @BotFather. Если он где-то засветился — /revoke и новый.
BOT_TOKEN=123456:AA...

# Ваш Telegram user_id (узнать: команда /id в боте). Можно несколько через запятую.
ADMIN_IDS=

# Часовой пояс расписания
TZ=Europe/Moscow

# Название в текстах
COLLEGE_NAME=Медколледж

# Путь к базе (по умолчанию data/schedule.sqlite3)
# DB_PATH=data/schedule.sqlite3

# Год для дат вида «14.09» без года
# DEFAULT_YEAR=2026

# Шаблон групп в шапке таблицы
# GROUP_REGEX=^\d{3}[СЛП]$

# Утренний дайджест (HH:MM, местное время TZ)
DIGEST_TIME=07:30
